# ---- Supabase (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Secret. Server only. Never expose in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Paystack (Settings > API Keys & Webhooks) ----
# Start with test keys (sk_test_...). Switch to live keys only after go-live checklist.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxx

# ---- Email (resend.com > API Keys) ----
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM="Gatepass <tickets@yourdomain.com>"

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Platform booking fee: percent and flat fee (naira) per paid ticket
FEE_PERCENT=5
FEE_FLAT_NAIRA=100
# Optional. The /api/cron route stays closed unless this is at least 16 characters.
CRON_SECRET=make-a-long-random-string
